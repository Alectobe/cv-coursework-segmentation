# Скопируйте в .env и заполните ключи ClearML:
# app.clear.ml -> Settings -> Workspace -> Create new credentials
CLEARML_API_HOST=https://api.clear.ml
CLEARML_WEB_HOST=https://app.clear.ml
CLEARML_FILES_HOST=https://files.clear.ml
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=

# Индекс колёс PyTorch для образа обучения:
#   cu128 - RTX 20xx/30xx/40xx/50xx (по умолчанию)
#   cu126 - если GPU старше (GTX 10xx и т.п.)
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

# Откуда сервис weights скачивает итоговые веса (GitHub Release).
WEIGHTS_URL=https://github.com/Alectobe/cv-coursework-segmentation/releases/download/v1.0/model.pt
# Альтернатива: ID модели в ClearML (если задан, используется вместо WEIGHTS_URL)
CLEARML_MODEL_ID=

# Порт сервиса инференса на хосте
API_PORT=8000
